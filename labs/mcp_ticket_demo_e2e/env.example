# Configuration for mcp-ticket-demo E2E testing with watsonx Orchestrate
# Copy to .env and adjust as needed

# Server transport mode: http
MCP_MODE=http
PORT=8080
HOST=0.0.0.0

# Authentication mode for mcp-ticket-demo:
# off   - No authentication (great for baseline reachability & handshake validation)
# write - Only write/pii tools require API key (search/get/describe are open)
# all   - Every tool call and discovery requires API key (tests header auth)
AUTH_MODE=off
MCP_API_KEY=demo-mcp-secret-key-12345

# WxO Toolkit & Agent Names
TOOLKIT_NAME=mcp_ticket_demo
AGENT_NAME=mcp_ticket_agent
CONNECTION_APP_ID=mcp_ticket_conn

# Transport to test: streamable_http or sse
MCP_TRANSPORT=streamable_http

# Optional: If you already have a static public URL (e.g. Code Engine or permanent ngrok domain)
# Leave empty to automatically start and detect ngrok
PUBLIC_URL=
