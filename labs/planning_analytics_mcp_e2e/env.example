# ==============================================================================
# IBM Planning Analytics as a Service — Environment Configuration
# ==============================================================================

# Instance Host & Identifiers
PA_HOST=us-east-1.planninganalytics.saas.ibm.com
PA_ACCOUNT_ID=35L2PSTGTSA4
PA_TENANT_ID=Z7LGTIG97RKC

# Derived MCP Endpoint
PA_MCP_URL=https://us-east-1.planninganalytics.saas.ibm.com/api/Z7LGTIG97RKC/v0/agentic-ai/ibm-pa-tools/mcp

# ------------------------------------------------------------------------------
# Flow 1: API Key / Basic Auth Configuration
# ------------------------------------------------------------------------------
# PA SaaS supports Basic Auth where username is "apikey" and password is the API key:
PA_API_KEY=your_planning_analytics_api_key_here

# ------------------------------------------------------------------------------
# Flow 2: OAuth 2.0 Authorization Code Flow Configuration
# ------------------------------------------------------------------------------
# Generated from PA Administration -> Integrations -> OAuth -> Add
PA_OAUTH_CLIENT_ID=your_oauth_client_id_here
PA_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
PA_OAUTH_AUTH_URL=https://us-east-1.planninganalytics.saas.ibm.com/oauth2/authorize
PA_OAUTH_TOKEN_URL=https://us-east-1.planninganalytics.saas.ibm.com/oauth2/token
PA_OAUTH_SCOPE=v0userContext
